# Network (config, not code). Monad testnet values from
# docs.monad.xyz/developer-essentials/testnet (verified 2026-09-22).
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_CHAIN_NAME=Monad Testnet
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com
# Attestation service (packages/attestor) and indexer GraphQL endpoint.
NEXT_PUBLIC_ATTESTOR_URL=
NEXT_PUBLIC_INDEXER_URL=
# Local Envio/Hasura only: the dev admin secret. Leave empty for hosted indexers.
NEXT_PUBLIC_INDEXER_DEV_SECRET=
# Optional: enables WalletConnect wallets in the connect modal.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# LOCAL ANVIL ONLY: address of an unlocked/impersonated anvil account for the
# dev wallet button. Must be empty in any deployed build.
NEXT_PUBLIC_DEV_WALLET=
