# Copy to .env (gitignored) and fill in. Never commit real values.

# --- network (config, not code) -------------------------------------------
# Monad testnet: chain id 10143, RPC https://testnet-rpc.monad.xyz
# (docs.monad.xyz/developer-essentials/testnet, verified 2026-09-22)
CHAIN_ID=
RPC_URL=

# --- attestation service (packages/attestor) -------------------------------
# Throwaway key used only for signing score attestations. Its address must
# equal ScoreRegistry.attestor() in deployments/<CHAIN_ID>.json.
ATTESTOR_PRIVATE_KEY=
# Envio HyperSync API token (envio.dev/app/api-tokens), for the independent
# borrowing-history check.
ENVIO_API_TOKEN=
# Optional: Alchemy API key for the history-check fallback (Aave on 5 chains).
ALCHEMY_API_KEY=
# ChainScore (prior art), called over the network. Legacy endpoint, see OBJECTIONS P2-O13.
CHAINSCORE_BASE_URL=https://chainscore.dev
SCORE_TTL_SECONDS=86400
SUBMIT_WINDOW_SECONDS=900
PORT=8787
# Comma-separated web origins allowed to call the service.
CORS_ORIGINS=
# Postgres for reservations, caches, refusal log (Supabase in deployment).
# Required off the local chain: a restart must not forget nonce reservations.
DATABASE_URL=
# PEM of the database's CA certificate (Supabase: Project Settings, Database,
# SSL). Newlines may be written as \n.
DATABASE_CA_CERT=
# Throwaway key that owns the mock oracle and re-stamps its prices daily
# (OBJECTIONS P4-O13). Never the deployer key. Required off the local chain.
ORACLE_KEEPER_PRIVATE_KEY=
KEEPER_INTERVAL_HOURS=24
# Hosted indexer GraphQL URL; the keeper queries it daily so it isn't idle.
INDEXER_URL=

# --- deploy script (contracts/script/Deploy.s.sol) --------------------------
ATTESTOR_ADDRESS=
MAX_PRICE_AGE=
GLOBAL_DEBT_CAP=
SEED_LIQUIDITY=
COLL_PRICE_WAD=
# Optional: address that takes ownership of the mock oracle after deploy
# (the oracle keeper's address).
ORACLE_OWNER=
