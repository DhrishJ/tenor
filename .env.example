# Copy to .env (gitignored) and fill in. Never commit real values.

# --- network (config, not code) -------------------------------------------
# Monad testnet: chain id 10143, RPC https://testnet-rpc.monad.xyz
# (docs.monad.xyz/developer-essentials/testnet, verified 2026-09-22)
CHAIN_ID=
RPC_URL=

# --- attestation service (packages/attestor) -------------------------------
# Throwaway key used only for signing score attestations. Its address must
# equal ScoreRegistry.attestor() in deployments/<CHAIN_ID>.json.
ATTESTOR_PRIVATE_KEY=
# Envio HyperSync API token (envio.dev/app/api-tokens), for the independent
# borrowing-history check.
ENVIO_API_TOKEN=
# Optional: Alchemy API key for the history-check fallback (Aave on 5 chains).
ALCHEMY_API_KEY=
# ChainScore (prior art), called over the network. Legacy endpoint, see OBJECTIONS P2-O13.
CHAINSCORE_BASE_URL=https://chainscore.dev
SCORE_TTL_SECONDS=86400
SUBMIT_WINDOW_SECONDS=900
PORT=8787

# --- deploy script (contracts/script/Deploy.s.sol) --------------------------
ATTESTOR_ADDRESS=
MAX_PRICE_AGE=
GLOBAL_DEBT_CAP=
SEED_LIQUIDITY=
COLL_PRICE_WAD=
